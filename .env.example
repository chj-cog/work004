# Supabase 프로젝트 → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# 서버 전용. 브라우저 코드에 쓰지 말 것
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# 공공데이터포털 → 마이페이지 → 한국천문연구원_특일 정보 → 일반 인증키(Decoding)
HOLIDAY_API_KEY=

# Vercel Cron 호출 확인용. 임의의 긴 문자열
CRON_SECRET=
